{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@uplift-io/uplift": ["packages/uplift/src/index.ts"],
      "@uplift-io/uplift/client": ["packages/uplift/src/client.ts"],
      "@uplift-io/uplift/react": ["packages/uplift/src/react.ts"],
      "@uplift-io/uplift/server": ["packages/uplift/src/server.ts"],
      "@uplift-io/bunny": ["packages/bunny/src/index.ts"],
      "@uplift-io/cloudinary": ["packages/cloudinary/src/index.ts"],
      "@uplift-io/express": ["packages/express/src/index.ts"],
      "@uplift-io/hono": ["packages/hono/src/index.ts"],
      "@uplift-io/local": ["packages/local/src/index.ts"],
      "@uplift-io/memory": ["packages/memory/src/index.ts"],
      "@uplift-io/next": ["packages/next/src/index.ts"],
      "@uplift-io/r2": ["packages/r2/src/index.ts"],
      "@uplift-io/rich": ["packages/rich/src/index.ts"],
      "@uplift-io/s3": ["packages/s3/src/index.ts"],
      "@uplift-io/uploadthing": ["packages/uploadthing/src/index.ts"]
    },
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "jsx": "react-jsx"
  }
}

{
  "name": "uplift-monorepo",
  "private": true,
  "license": "MIT",
  "homepage": "https://itzfeminisce.github.io/uplift/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Itzfeminisce/uplift.git"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm --filter uplift build",
    "bundle:size": "node scripts/measure-bundle-size.mjs",
    "docs:check": "tsc -p docs/snippets/tsconfig.json --noEmit",
    "examples:check": "pnpm --filter \"@uplift/example-*\" typecheck",
    "smoke:pack": "node scripts/smoke-pack.mjs",
    "test": "pnpm --filter uplift test",
    "typecheck": "pnpm --filter uplift typecheck",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm docs:check && pnpm examples:check && pnpm bundle:size && pnpm smoke:pack"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.12",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.8",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "packageManager": "pnpm@10.0.0",
  "version": "0.0.0"
}

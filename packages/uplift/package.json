{
  "name": "@uplift-io/uplift",
  "version": "1.0.0",
  "description": "Dead-simple, type-safe file handling for TypeScript applications.",
  "license": "MIT",
  "homepage": "https://itzfeminisce.github.io/uplift/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Itzfeminisce/uplift.git",
    "directory": "packages/uplift"
  },
  "bugs": {
    "url": "https://github.com/Itzfeminisce/uplift/issues"
  },
  "keywords": [
    "upload",
    "file-upload",
    "typescript",
    "multipart",
    "s3",
    "r2",
    "nextjs",
    "hono",
    "express",
    "react"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "react": "^19.0.0"
  }
}
